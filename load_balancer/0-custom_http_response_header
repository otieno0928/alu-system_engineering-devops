#!/usr/bin/env bash
# shellcheck disable=SC2154
# Configures Nginx to add a custom X-Served-By HTTP response header with the server hostname
apt-get update -y
apt-get install nginx -y

python3 -c '
with open("/etc/nginx/sites-available/default", "r") as f:
    lines = f.readlines()

new_lines = []
added = False
for line in lines:
    new_lines.append(line)
    if "server_name" in line and not added:
        new_lines.append("    add_header X-Served-By $hostname;\n")
        added = True

with open("/etc/nginx/sites-available/default", "w") as f:
    f.writelines(new_lines)
'

/etc/init.d/nginx restart
