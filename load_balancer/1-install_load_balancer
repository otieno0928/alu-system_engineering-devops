#!/usr/bin/env bash
# Installs and configures HAProxy to load balance traffic between web-01 and web-02 using roundrobin
apt-get update -y
apt-get install haproxy -y

# Enable HAproxy init script execution
sed -i 's/ENABLED=0/ENABLED=1/' /etc/default/haproxy

# Configure haproxy.cfg
cat << 'CONFIG' > /etc/haproxy/haproxy.cfg
global
0-custom_http_response_header log /dev/loglocal0
0-custom_http_response_header log /dev/loglocal1 notice
0-custom_http_response_header chroot /var/lib/haproxy
0-custom_http_response_header user haproxy
0-custom_http_response_header group haproxy
0-custom_http_response_header daemon

defaults
0-custom_http_response_header logglobal
0-custom_http_response_header modehttp
0-custom_http_response_header optionhttplog
0-custom_http_response_header optiondontlognull
    timeout connect 5000
    timeout client  50000
    timeout server  50000

frontend haproxy_frontend
0-custom_http_response_header bind *:80
0-custom_http_response_header mode http
0-custom_http_response_header default_backend haproxy_backend

backend haproxy_backend
0-custom_http_response_header balance roundrobin
0-custom_http_response_header server 7384-web-01 13.40.153.43:80 check
0-custom_http_response_header server 7384-web-02 54.89.38.100:80 check
CONFIG

/etc/init.d/haproxy restart
