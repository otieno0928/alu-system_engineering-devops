#!/usr/bin/env bash
# Installs and configures HAProxy to load balance traffic between web-01 and web-02 using roundrobin
apt-get update -y
apt-get install haproxy -y

# Enable HAproxy init script execution
sed -i 's/ENABLED=0/ENABLED=1/' /etc/default/haproxy

# Configure haproxy.cfg with exact backend names web-01 and web-02
cat << 'CONFIG' > /etc/haproxy/haproxy.cfg
global
log /dev/loglocal0
log /dev/loglocal1 notice
chroot /var/lib/haproxy
user haproxy
group haproxy
daemon

defaults
logglobal
modehttp
optionhttplog
optiondontlognull
timeout connect 5000
timeout client  50000
timeout server  50000

frontend haproxy_frontend
bind *:80
mode http
default_backend haproxy_backend

backend haproxy_backend
balance roundrobin
server web-01 13.40.153.43:80 check
server web-02 3.8.141.113:80 check
CONFIG

/etc/init.d/haproxy restart
