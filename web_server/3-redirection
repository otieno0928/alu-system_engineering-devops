#!/usr/bin/env bash
# Configures Nginx with a 301 Moved Permanently redirect from /redirect_me to YouTube
apt-get update -y
apt-get install nginx -y
python3 -c '
with open("/etc/nginx/sites-available/default", "r") as f:
    content = f.read()
target = "server_name _;"
replacement = "server_name _;\n\n\tlocation /redirect_me {\n\t\treturn 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;\n\t}"
if target in content and "location /redirect_me" not in content:
    content = content.replace(target, replacement, 1)
with open("/etc/nginx/sites-available/default", "w") as f:
    f.write(content)
'
/etc/init.d/nginx restart
