#!/usr/bin/env bash
# Configures a custom 404 error page containing "Ceci n'est pas une page"
apt-get update -y
apt-get install nginx -y
echo "Ceci n'est pas une page" > /var/www/html/custom_404.html
python3 -c '
with open("/etc/nginx/sites-available/default", "r") as f:
    content = f.read()
target = "server_name _;"
replacement = "server_name _;\n\n\terror_page 404 /custom_404.html;\n\tlocation = /custom_404.html {\n\t\troot /var/www/html;\n\t\tinternal;\n\t}"
if target in content and "error_page 404" not in content:
    content = content.replace(target, replacement, 1)
with open("/etc/nginx/sites-available/default", "w") as f:
    f.write(content)
'
/etc/init.d/nginx restart
