#!/usr/bin/env bash
# Configure Nginx to listen on port 80 and ensure it's enabled and running
sed -i 's/listen 8080 default_server;/listen 80 default_server;/g' /etc/nginx/sites-available/default
sed -i 's/listen \[::\]:8080 default_server;/listen [::]:80 default_server;/g' /etc/nginx/sites-available/default
service nginx restart
