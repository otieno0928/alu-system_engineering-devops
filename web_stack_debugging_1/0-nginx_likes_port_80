#!/usr/bin/env bash
# Configure Nginx to listen on port 80 across all config files and restart
sed -i 's/listen 8080/listen 80/g' /etc/nginx/sites-enabled/* 2>/dev/null || true
sed -i 's/listen 8080/listen 80/g' /etc/nginx/sites-available/* 2>/dev/null || true
sed -i 's/listen 8080/listen 80/g' /etc/nginx/nginx.conf 2>/dev/null || true
service nginx restart
