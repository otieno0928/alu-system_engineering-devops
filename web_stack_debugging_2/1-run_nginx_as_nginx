#!/usr/bin/env bash
# Configure Nginx user to nginx, port to 8080, and restart service
sed -i 's/user www-data;/user nginx;/g' /etc/nginx/nginx.conf
sed -i 's/user root;/user nginx;/g' /etc/nginx/nginx.conf
sed -i 's/listen 80 default_server;/listen 8080 default_server;/g' /etc/nginx/sites-enabled/default
sed -i 's/listen \[::\]:80 default_server;/listen [::]:8080 default_server;/g' /etc/nginx/sites-enabled/default
service nginx restart
